#
# x86_64 system tests
#

X64_SYSTEM_SRC=$(SRC_PATH)/tests/tcg/x86_64/system
X64_SYSTEM_TESTS=$(patsubst $(X64_SYSTEM_SRC)/%.c, %, $(wildcard $(X64_SYSTEM_SRC)/*.c))

VPATH+=$(X64_SYSTEM_SRC)

# These objects provide the basic boot code and helper functions for all tests
CRT_OBJS=boot.o

CRT_PATH=$(X64_SYSTEM_SRC)
LINK_SCRIPT=$(X64_SYSTEM_SRC)/kernel.ld
LDFLAGS=-Wl,-T$(LINK_SCRIPT) -Wl,-melf_x86_64
CFLAGS+=-nostdlib -ggdb -O0 $(MINILIB_INC)
LDFLAGS+=-static -nostdlib $(CRT_OBJS) $(MINILIB_OBJS) -lgcc

TESTS+=$(MULTIARCH_TESTS) $(X64_SYSTEM_TESTS)
EXTRA_RUNS+=$(MULTIARCH_RUNS)

# building head blobs
.PRECIOUS: $(CRT_OBJS)

%.o: $(CRT_PATH)/%.S
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) -Wa,--noexecstack -c $< -o $@

# The same boot code with the SEV-SNP C-bit bootstrap compiled in.  Only the
# strict-mode test wants it: adopting the C-bit is wrong in any configuration
# where guest RAM is not private, and the guest has no way to tell.
boot-snp.o: $(CRT_PATH)/boot.S
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) -DSNP_CBIT_BOOT -Wa,--noexecstack -c $< -o $@
.PRECIOUS: boot-snp.o

# Likewise for TDX: accepting .bss is wrong wherever guest memory is not
# pending, and a TD cannot tell which it is in.
boot-tdx.o: $(CRT_PATH)/boot.S
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) -DTDX_ACCEPT_BOOT -Wa,--noexecstack -c $< -o $@
.PRECIOUS: boot-tdx.o

# Build and link the tests
%: %.c $(LINK_SCRIPT) $(CRT_OBJS) $(MINILIB_OBJS)
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) $< -o $@ $(LDFLAGS)

sev-snp-strict: sev-snp-strict.c $(LINK_SCRIPT) boot-snp.o $(MINILIB_OBJS)
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) $< -o $@ \
		-Wl,-T$(LINK_SCRIPT) -Wl,-melf_x86_64 -static -nostdlib \
		boot-snp.o $(MINILIB_OBJS) -lgcc

tdx-strict: tdx-strict.c $(LINK_SCRIPT) boot-tdx.o $(MINILIB_OBJS)
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) $< -o $@ \
		-Wl,-T$(LINK_SCRIPT) -Wl,-melf_x86_64 -static -nostdlib \
		boot-tdx.o $(MINILIB_OBJS) -lgcc

memory: CFLAGS+=-DCHECK_UNALIGNED=1

# boot.S leaves SSE disabled (CR4.OSFXSR clear), so anything the compiler
# vectorises -- a struct initialiser is enough -- would #UD.
tdx: CFLAGS+=-mgeneral-regs-only
sev-snp: CFLAGS+=-mgeneral-regs-only
sev-snp-vc: CFLAGS+=-mgeneral-regs-only
sev-snp-ghcb: CFLAGS+=-mgeneral-regs-only
sev-snp-nae: CFLAGS+=-mgeneral-regs-only
sev-snp-rmp: CFLAGS+=-mgeneral-regs-only
sev-snp-cbit: CFLAGS+=-mgeneral-regs-only
sev-snp-strict: CFLAGS+=-mgeneral-regs-only
sev-snp-dma: CFLAGS+=-mgeneral-regs-only
sev-snp-attest: CFLAGS+=-mgeneral-regs-only
tdx-sept: CFLAGS+=-mgeneral-regs-only
tdx-attest: CFLAGS+=-mgeneral-regs-only
tdx-strict: CFLAGS+=-mgeneral-regs-only
tdx-dma: CFLAGS+=-mgeneral-regs-only

# Running
X64_SYSTEM_OPTS=-device isa-debugcon,chardev=output \
                -device isa-debug-exit,iobase=0xf4,iosize=0x4
QEMU_OPTS+=$(X64_SYSTEM_OPTS) -kernel

# The emulated TDX guest interface is off unless asked for.
run-tdx: QEMU_OPTS=-cpu max,x-tdx-guest=on $(X64_SYSTEM_OPTS) -kernel
run-tdx-attest: QEMU_OPTS=-cpu max,x-tdx-guest=on $(X64_SYSTEM_OPTS) -kernel

# Page state in lazy mode: pages start accepted, so the test's own memory keeps
# working while the pages under test are converted.  I/O is relaxed because the
# first TDCALL arms reflection and this test's #VE handler is for EPT
# violations, not for servicing I/O.
TDX_SEPT_CPU=max,x-tdx-guest=on,x-tdx-sept=1
run-tdx-sept: QEMU_OPTS=-cpu $(TDX_SEPT_CPU) $(X64_SYSTEM_OPTS) -kernel

# Device DMA: the SHARED alias is necessary but not sufficient, so the filter
# also asks whether the page was ever converted.
# edu clamps DMA addresses to its dma_mask, which defaults to 28 bits and would
# strip the SHARED alias before the filter ever saw it.
run-tdx-dma: QEMU_OPTS=-cpu $(TDX_SEPT_CPU) \
             -device edu,dma_mask=0xffffffffffff $(X64_SYSTEM_OPTS) -kernel

# Strict mode: guest RAM private and pending, only the launch image accepted.
# Nothing boots here without the accept bootstrap, which is what is being shown.
run-tdx-strict: QEMU_OPTS=-cpu max,x-tdx-guest=on,x-tdx-sept=2 \
                $(X64_SYSTEM_OPTS) -kernel
run-sev-snp: QEMU_OPTS=-cpu max,x-sev-snp-guest=on $(X64_SYSTEM_OPTS) -kernel

# Attestation: the guest seals its own request with AES-256-GCM under a VMPCK
# from the secrets page, so the emulator has to interoperate with an independent
# implementation of the same construction.
SNP_ATTEST_CPU=max,x-sev-snp-guest=on,x-sev-snp-secrets-gpa=0x4000000
run-sev-snp-attest: QEMU_OPTS=-cpu $(SNP_ATTEST_CPU) $(X64_SYSTEM_OPTS) -kernel
# I/O is relaxed: a handler with no GHCB cannot service it, and both the test's
# output and its exit are port I/O.  See the comment in sev-snp-vc.c.
run-sev-snp-vc: QEMU_OPTS=-cpu max,x-sev-snp-guest=on,x-sev-snp-relax-io=on \
                $(X64_SYSTEM_OPTS) -kernel

# Drives the GHCB MSR protocol without arming reflection, so its own output
# still works; the protocol is what a guest needs before it can service #VC.
run-sev-snp-ghcb: QEMU_OPTS=-cpu max,x-sev-snp-guest=on $(X64_SYSTEM_OPTS) -kernel

# Full strict I/O: the guest services its own port access through the GHCB, so
# the test's output is itself proof the NAE path works.
run-sev-snp-nae: QEMU_OPTS=-cpu max,x-sev-snp-guest=on $(X64_SYSTEM_OPTS) -kernel

# RMP-lite in lazy mode: pages are shared until claimed, so the test's own code
# and stack keep working while the page it claims is tracked for real.  I/O is
# relaxed for the same reason as sev-snp-vc: PVALIDATE arms reflection, and this
# test installs no handler.
SNP_RMP_CPU=max,x-sev-snp-guest=on,x-sev-snp-rmp=1,x-sev-snp-relax-io=on
run-sev-snp-rmp: QEMU_OPTS=-cpu $(SNP_RMP_CPU) $(X64_SYSTEM_OPTS) -kernel

# Same configuration, but this one builds its own C-bit page tables and so
# reaches the private side of the page-state check.  HLT is relaxed as well:
# boot.S halts on the way out, after main() has returned, and a #VC there would
# be reported by a handler whose job here is page faults.
SNP_CBIT_CPU=$(SNP_RMP_CPU),x-sev-snp-relax-hlt=on
run-sev-snp-cbit: QEMU_OPTS=-cpu $(SNP_CBIT_CPU) $(X64_SYSTEM_OPTS) -kernel

# Device DMA, driven through the edu device's DMA engine.  Needs page-state
# tracking, since that is what the filter consults; lazy keeps the test's own
# memory reachable while the one page under test is private.
run-sev-snp-dma: QEMU_OPTS=-cpu $(SNP_RMP_CPU) -device edu $(X64_SYSTEM_OPTS) \
                 -kernel

# Strict mode: guest RAM private, only the launch image validated.  Nothing
# boots here without the C-bit bootstrap, which is the result being checked.
SNP_STRICT_CPU=max,x-sev-snp-guest=on,x-sev-snp-rmp=2,x-sev-snp-relax-io=on,x-sev-snp-relax-hlt=on
run-sev-snp-strict: QEMU_OPTS=-cpu $(SNP_STRICT_CPU) $(X64_SYSTEM_OPTS) -kernel

ifeq ($(CONFIG_PLUGIN),y)
run-plugin-patch-target-with-libpatch.so:		\
	PLUGIN_ARGS=$(COMMA)target=ffc0$(COMMA)patch=9090$(COMMA)use_hwaddr=true
run-plugin-patch-target-with-libpatch.so:		\
	CHECK_PLUGIN_OUTPUT_COMMAND=$(X64_SYSTEM_SRC)/validate-patch.py $@.out
run-plugin-patch-target-with-libpatch.so: patch-target libpatch.so
EXTRA_RUNS_WITH_PLUGIN+=run-plugin-patch-target-with-libpatch.so
endif
